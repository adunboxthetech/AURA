# App/runtime
APP_ENV=development
API_HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CORS_EXPOSE_HEADERS=Accept-Ranges, Content-Range, Content-Length, ETag, Retry-After
VITE_API_BASE_URL=http://localhost:8000/api
VITE_NEON_AUTH_URL=https://your-neon-auth-url
OFFLINE_DEMO_MODE=false
LOG_LEVEL=INFO

# Neon Postgres + Neon Auth
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require
NEON_AUTH_URL=https://your-neon-auth-url
NEON_AUTH_ISSUER=https://your-neon-auth-issuer
NEON_AUTH_AUDIENCE=your-api-audience
NEON_AUTH_JWKS_URL=https://your-neon-auth-jwks-url

# Neon S3-compatible Object Storage (private bucket)
OBJECT_STORAGE_ENDPOINT=https://your-neon-s3-endpoint
OBJECT_STORAGE_REGION=your-region
OBJECT_STORAGE_BUCKET=coursework-pdfs
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORAGE_ADDRESSING_STYLE=path
PDF_CACHE_MAX_AGE_SECONDS=86400

# Upload, OCR, quotas, and ingestion
MAX_UPLOAD_MB=40
MAX_PDF_PAGES=500
MAX_OCR_PAGES=40
MAX_USER_STORAGE_MB=100
MAX_USER_SOURCES=10
MAX_GLOBAL_OBJECT_STORAGE_MB=4500
MAX_GLOBAL_DB_USAGE_MB=850
OCR_MIN_TEXT_CHARS=40
OCR_RENDER_DPI=150
OCR_MAX_PAGE_PIXELS=12000000
OCR_PAGE_TIMEOUT_SECONDS=30
INGESTION_STALE_TIMEOUT_SECONDS=300
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=5
EMBEDDING_BACKOFF_BASE_SECONDS=1

# Embeddings and retrieval
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=configure-current-supported-model
EMBEDDING_DIMENSIONS=768
MAX_HISTORY_TURNS=3
MAX_CONTEXT_TOKENS=3500
RRF_K=60
DENSE_CANDIDATE_LIMIT=30
LEXICAL_CANDIDATE_LIMIT=30
RETRIEVAL_TOP_K=8
ABSTENTION_THRESHOLD=configure-after-evaluation

# LLM providers (server-side placeholders only)
LLM_PRIMARY=groq
LLM_FALLBACK=gemini
GROQ_API_KEY=replace-me
GEMINI_API_KEY=replace-me
LLM_PRIMARY_MODEL=configure-current-supported-model
LLM_FALLBACK_MODEL=configure-current-supported-model
LLM_REQUEST_TIMEOUT_SECONDS=60

# Rate limits
RATE_LIMIT_USER_PER_MINUTE=20
RATE_LIMIT_IP_PER_MINUTE=10
RATE_LIMIT_UPLOADS_PER_HOUR=10

